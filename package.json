    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-query-devtools": "^5.100.10",
    "@types/pdf-parse": "^1.1.5",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.14.0",
    "next": "15.5.18",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
