    "test:watch": "vitest",
    "electron:dev": "tsc -p electron/tsconfig.json && electron electron/dist/main.js",
    "electron:build": "tsc -p electron/tsconfig.json && electron-builder --config electron-builder.config.js"
  },
  "dependencies": {
